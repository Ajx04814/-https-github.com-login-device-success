# URL da sua Evolution API (sem barra no final)
EVO_URL=https://sua-evolution-api.com
# Chave global da Evolution API (header "apikey")
EVO_TOKEN=coloque-sua-apikey-aqui
# Nome da instância
EVO_INSTANCIA=naia
# URL pública que recebe os eventos (ex.: túnel ngrok apontando para a porta abaixo)
WEBHOOK_URL=https://seu-dominio.com/webhook
PORT=3000
# Número de teste (DDI + DDD + número)
NUMERO_TESTE=5521965250104
