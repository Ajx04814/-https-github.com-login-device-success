# ── Evolution API ─────────────────────────────────────────
# URL da sua Evolution API (sem barra no final)
EVO_URL=http://localhost:8080
# Chave global da Evolution API (header "apikey"). Use uma chave longa e aleatória.
EVO_TOKEN=troque-por-uma-chave-longa-e-aleatoria
EVO_INSTANCIA=naia

# ── Número ────────────────────────────────────────────────
# Número do chip conectado na Naia (DDI + DDD + número). É o número protegido.
NUMERO_NAIA=5521965250104
# Para onde vai a mensagem de teste (padrão: o próprio número da Naia)
NUMERO_TESTE=5521965250104

# ── Webhook ───────────────────────────────────────────────
# URL pública que recebe os eventos (ex.: túnel apontando para a porta abaixo)
WEBHOOK_URL=https://seu-dominio.com/webhook
# Segredo enviado como ?token=... (gere com: openssl rand -hex 24)
WEBHOOK_SECRET=
PORT=3000

# ── Proteção anti-banimento (padrões conservadores) ───────
LIMITE_POR_MINUTO=6
LIMITE_POR_HORA=60
LIMITE_POR_DIA=200
# Mensagens para quem nunca falou com a Naia. Número novo: comece com 5-10.
LIMITE_NOVOS_POR_DIA=10
INTERVALO_MIN_MS=3000
INTERVALO_MAX_MS=8000
ARQUIVO_ESTADO=data/estado.json

# ── docker-compose (Evolution API própria) ────────────────
POSTGRES_PASSWORD=troque-esta-senha
